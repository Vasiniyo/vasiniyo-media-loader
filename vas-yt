#!/bin/bash

trap 'exit 1' INT

logo() {
  cat <<'EOF'
 _   __         _      _           __  ___       ___      __                __
| | / /__ ____ (_)__  (_)_ _____  /  |/  /__ ___/ (_)__ _/ /  ___  ___ ____/ /__ ____
| |/ / _ `(_-</ / _ \/ / // / _ \/ /|_/ / -_) _  / / _ `/ /__/ _ \/ _ `/ _  / -_) __/
|___/\_,_/___/_/_//_/_/\_, /\___/_/  /_/\__/\_,_/_/\_,_/____/\___/\_,_/\_,_/\__/_/
                      /___/
EOF
}

usage() {
    cat <<EOF
Usage: $(basename "$0") --output <output_dir> (--link <name> | --links <file>) [OPTION]...

Options:
  -o, --output <output_dir>  output directory
      --link <name>          youtube link
      --links <file>         file with youtube links
  -r, --runtime              runtime mode (default: docker)
  -b, --build                rebuild docker container
      --stop                 stop docker container
      --debug                debug mode
  -q, --quiet                quiet mode
  -h, --help                 display this help and exit

Examples:
  $(basename "$0") \\
    --output out \\
    --link https://www.youtube.com/watch?v=dQw4w9WgXcQ \\
    --runtime docker
  $(basename "$0") -o out --links path/to/links.txt -q --runtime local
EOF
    exit 1
}

get_arg() {
  if [[ -z "$1" ]]; then
    usage
  fi
  echo "$1"
}

LINK_FILES=()
LINKS=()
RUNTIME_MODE="docker"
DEBUG=''
QUIET_MODE=''
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output)
            OUTPUT_DIR="$(get_arg "$2")"
            shift 2
            ;;
        --links)
            file="$(get_arg "$2")"
            if [ ! -f $file ]; then
              echo "Error: file '$file' not exists." >&2
              exit 2
            fi
            LINK_FILES+=("$file")
            shift 2
            ;;
        --link)
            LINKS+=("$(get_arg "$2")")
            shift 2
            ;;
        -q|--quiet)
            QUIET_MODE="TRUE"
            shift 1
            ;;
        -r|--runtime)
            RUNTIME_MODE="$(get_arg "$2")"
            if [[ "$RUNTIME_MODE" != "local" && "$RUNTIME_MODE" != "docker" ]]; then
                echo "Error: invalid runtime: $RUNTIME_MODE (allowed: local, docker)"
                exit 1
            fi
            if ! command -v docker &> /dev/null ; then
                echo "You should install Docker: https://docs.docker.com/get-started/get-docker"
                exit 1
            fi
            shift 2
            ;;
        -b|--build)
          REBUILD_CONTAINER="$(get_arg "$2")"
          shift 1
          ;;
        --stop)
          STOP_CONTAINER="$(get_arg "$2")"
          shift 1
          ;;
        --debug)
            DEBUG="TRUE"
            shift 1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

CONTAINER_NAME="vasiniyo_media_loader"

stop_container() {
  if [[ -z $QUIET_MODE ]]; then
    echo "Stopping old $CONTAINER_NAME..." >&2
  fi
  docker stop "$CONTAINER_NAME" 2>/dev/null
  if [[ -z $QUIET_MODE ]]; then
    echo "Removing old $CONTAINER_NAME..." >&2
  fi
  docker rm "$CONTAINER_NAME" 2>/dev/null
}

if [ -n "$STOP_CONTAINER" ]; then
  stop_container
  exit 0
fi

if [[ -z "$OUTPUT_DIR" || ( -z "$LINK_FILES" && -z "$LINKS") ]]; then
  usage
fi
SCRIPT_DIR="$(dirname "$(realpath -m "$0")")"
LOG_DIR="$SCRIPT_DIR/logs"
OUTPUT_PATH="ytloads/$OUTPUT_DIR"
LOG_FILE="$LOG_DIR/$(date '+%Y-%m-%d-%H-%M-%S').log"
mkdir -p "$LOG_DIR" "$OUTPUT_PATH"

print_logo() {
  if [[ -z $QUIET_MODE ]]; then
    echo "$(logo)" >&2
  fi
  echo "$(logo)" > "$LOG_FILE"
}

if [[ "$RUNTIME_MODE" == "local" ]]; then

  if ! command -v deno >/dev/null 2>&1; then
    echo "Error: js runtime 'deno' not installed (Debian):" >&2
    echo "  curl -fsSL https://deno.land/install.sh | sh" >&2
    exit 1
  fi

  if ! command -v python3 >/dev/null 2>&1; then
      echo "Error: python3 not installed" >&2
      exit 1
  fi
  if ! python3 -m venv --help >/dev/null 2>&1; then
      echo "Error: python3-venv not installed (Debian):" >&2
      echo "  sudo apt install python3-venv" >&2
      exit 1
  fi
  VENV_DIR="$SCRIPT_DIR/.venv"
  if [[ ! -d "$VENV_DIR" ]]; then
      echo "Creating virtual environment..." >&2
      python3 -m venv "$VENV_DIR"
  fi
  if [[ ! -x "$VENV_DIR/bin/pip" ]]; then
      echo "Error: pip not found in venv" >&2
      exit 1
  fi
  python="$VENV_DIR/bin/python"
  "$python" -m pip ${QUIET_MODE:+-q} install --upgrade pip >&2
  "$python" -m pip ${QUIET_MODE:+-q} install -r "$SCRIPT_DIR/requirements.txt" >&2
  "$python" -m pip ${QUIET_MODE:+-q} install -e "$SCRIPT_DIR" >&2

  export OUTPUT_PATH QUIET_MODE DEBUG LOG_FILE
  trap - INT
  print_logo
  "$python" -u -m vasiniyo_media_loader < <(
    test "${#LINKS[@]}" -gt 0 && printf '%s\n' "${LINKS[@]}"
    test "${#LINK_FILES[@]}" -gt 0 && cat "${LINK_FILES[@]}"
  )
  exit 0
fi

if [[ -n "$REBUILD_CONTAINER" ]] || ! docker image ls --format "{{.Repository}}:{{.Tag}}" | grep -q "$CONTAINER_NAME:latest"; then
  if [[ -z $QUIET_MODE ]]; then
    echo "Building $CONTAINER_NAME..." >&2
    docker build -t "$CONTAINER_NAME:latest" "$SCRIPT_DIR" >&2
  else
    docker build -t "$CONTAINER_NAME:latest" "$SCRIPT_DIR" &> /dev/null
  fi
  if [ $? -ne 0 ]; then
      echo "Failed to build image $CONTAINER_NAME" >&2
      exit 1
  fi
fi
stop_container
trap stop_container INT
print_logo
(
  test "${#LINKS[@]}" -gt 0 && printf '%s\n' "${LINKS[@]}"
  test "${#LINK_FILES[@]}" -gt 0 && cat "${LINK_FILES[@]}"
) | \
docker run -i \
           --rm \
           --name "$CONTAINER_NAME" \
           --user $(id -u):$(id -g) \
           -v "$LOG_FILE":"/logs/logs.log" \
           -v "$(pwd)/ytloads":"/ytloads" \
           -v "$HOME/.config/BraveSoftware/Brave-Browser":"/.config/BraveSoftware/Brave-Browser" \
           -v "/run/user/$(id -u)/bus":"/run/user/1000/bus" \
           -e DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus" \
           -e OUTPUT_PATH="$OUTPUT_PATH" \
           -e QUIET_MODE="$QUIET_MODE" \
           -e DEBUG="$DEBUG" \
           -e LOG_FILE="/logs/logs.log" \
           "$CONTAINER_NAME:latest"
